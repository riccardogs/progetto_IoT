{
  "seed": 42,
  "results_folder": "results",
  "num_workers": 8,
  "dataset": {
    "dset_path": "./dset/Sleep-EDF-2018/npz/Fpz-Cz",
    "max_files": 45
  },
  "pretraining_params": {
    "batch_size": 512,
    "temperature": 0.20,
    "dropout_rate": 0.2,
    "latent_dim": 64,
    "learning_rate": 0.001,
    "weight_decay": 0.0005,
    "max_epochs": 10,
    "check_interval": 5,
    "min_improvement": 0.001,
    "best_model_pth": "checkpoints/encoder/encoder_"
  },
  "latent_space_params": {
    "umap_enabled": false,
    "pca_enabled": false,
    "tsne_enabled": true,
    "visualize": true,
    "compute_metrics": false,
    "n_clusters": 5,
    "output_image_dir": "latent_space/visualizations",
    "output_metrics_dir": "latent_space/metrics",
    "visualization_fraction": 0.5
  },
  "sup_training_params": {
    "learning_rate": 0.001,
    "max_epochs": 15,
    "dropout_rate": 0.5,
    "check_interval": 5,
    "min_improvement": 0.001,
    "best_model_pth": "checkpoints/classifier/classifier_"
  },
  "experiment_num": 10122,
  "augmentations": {
    "TimeWarping": {
      "p": 0.7,
      "n_segments": 4,
      "scale_range": [0.5, 2.0]
    },
    "RandomTimeShift": {
      "p": 0.4,
      "range": [-100, 100],
      "mode": "constant",
      "cval": 0.0
    },
    "SignFlip": {
      "p": 0.25
    },
    "RandomFrequencyMask": {
      "p": 0.35,
      "range": [4.0, 7.0],
      "mask_ratio": 0.4,
      "sampling_rate": 100.0
    }
  }
}
