{
  "seed": 42,
  "results_folder": "results",
  "num_workers": 8,
  "dataset": {
    "dset_path": "./dset/Sleep-EDF-2018/npz/Fpz-Cz",
    "max_files": 45
  },
  "pretraining_params": {
    "batch_size": 512,
    "temperature": 0.1,
    "dropout_rate": 0.2,
    "latent_dim": 64,
    "learning_rate": 0.001,
    "max_epochs": 10,
    "check_interval": 10,
    "min_improvement": 0.0001,
    "best_model_pth": "checkpoints/encoder/encoder_"
  },
  "latent_space_params": {
    "umap_enabled": false,
    "pca_enabled": false,
    "tsne_enabled": true,
    "visualize": true,
    "compute_metrics": false,
    "n_clusters": 5,
    "output_image_dir": "latent_space/visualizations",
    "output_metrics_dir": "latent_space/metrics",
    "visualization_fraction": 0.5
  },
  "sup_training_params": {
    "learning_rate": 0.001,
    "max_epochs": 15,
    "dropout_rate": 0.5,
    "check_interval": 15,
    "min_improvement": 0.0005,
    "best_model_pth": "checkpoints/classifier/classifier_"
  },
  "experiment_num": 10005,
  "augmentations": {
    "TimeWarping": {
      "p": 0.7,
      "n_segments": 4,
      "scale_range": [
        0.5,
        2.0
      ]
    }
  }
}